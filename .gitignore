# .NET
bin/
obj/
*.user
.vs/

# Node / TypeScript
node_modules/
dist/
.vite/
*.tsbuildinfo
.eslintcache

# Env / secrets
.env
.env.*
!.env.example
!.env.nas.example

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Local Claude Code session state
.claude/

# Logs
*.log
npm-debug.log*

# Bicep build output (ARM JSON) — the .bicep/.bicepparam source is what's committed
infrastructure/bicep/**/*.json
infrastructure/bicep/*.local.bicepparam

# GeoIP databases — downloaded at deploy time (MaxMind licensing / file size), never committed.
# See infrastructure/compose/scripts/refresh-geoip.sh and infrastructure/compose/geoip/README.md
*.mmdb
