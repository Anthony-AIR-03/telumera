# Local dev config. Copy to `.env` in this same directory and fill in real values — `.env` /
# `.env.*` are already git-ignored (see repo-root .gitignore), only this `.env.example` is
# committed. Not classic secrets (a tenant/client ID is visible in any issued token or redirect
# URI, and MSAL public clients never hold a secret at all), but kept out of committed config
# anyway since they're specific to one person's Entra ID tenant — same reasoning as
# infrastructure/compose/.env.example's AzureAd values.

# Where the gateway is reachable from the browser (infrastructure/compose's gateway service).
VITE_API_BASE_URL=http://localhost:5100

# Tenant ID from the Entra admin center's Overview page — same tenant as
# infrastructure/compose/.env's AZURE_AD_TENANT_ID.
VITE_AZURE_AD_TENANT_ID=

# Application (client) ID of the "Telumera Dashboard" app registration (Single-page application
# platform, redirect URI http://localhost:5173) — distinct from the "Telumera API" and
# "Telumera CLI Test Client" registrations used elsewhere. See docs/runbooks/local-environment.md.
VITE_AZURE_AD_CLIENT_ID=

# The scope to request when acquiring a token to call the gateway — api://<Telumera API client
# ID>/access_as_user. Same access_as_user scope every backend service already validates.
VITE_AZURE_AD_API_SCOPE=
