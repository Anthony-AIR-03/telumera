<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.2.0" />
    <PackageReference Include="NBomber.Http" Version="6.2.0" />
    <!-- Forces a newer MessagePack than NBomber's own dependency pulls in — that transitive version
         has known moderate/high-severity advisories (NU1902/NU1903 without this override). -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
