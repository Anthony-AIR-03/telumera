{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aggregation": {
    "IntervalSeconds": 60,
    "WatermarkSafetyBufferSeconds": 300
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "Cache": {
    "TtlSeconds": 60
  },
  "ClickHouse": {
    "QueryTimeoutSeconds": 10
  }
}
