<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sdk.Web (not templates/worker-service, despite this being conceptually a consumer/worker):
         Dapr pub/sub delivery is HTTP-push into the app (confirmed live via event-collector's own
         subscription in M01.3), which needs Kestrel regardless. Postgres/EF Core here is only for
         packages/idempotency's dedup markers — the actual analytics data goes to ClickHouse via its
         plain HTTP interface (ClickHouseWriter.cs), not an EF Core provider. -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.5" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- M01.6: Entra ID auth for the new query endpoints (same package/version site-registry and
         identity-workspace already use) and the repo's first real Redis consumer — the standard
         IDistributedCache abstraction, not a hand-rolled client, since (unlike ClickHouse.Client)
         StackExchange.Redis has no net10.0 compatibility gap to work around. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- M01.8: real geography enrichment. Reads a local MaxMind-format .mmdb country DB in-process
         (GeoLite2 Country or DB-IP Lite Country — same format); no visitor IP leaves the box, and the
         DB file itself is never committed (see .gitignore / scripts/refresh-geoip.sh). -->
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\dotnet-service-defaults\Telumera.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\packages\event-contracts\Telumera.EventContracts.csproj" />
    <ProjectReference Include="..\..\packages\idempotency\Telumera.Idempotency.csproj" />
  </ItemGroup>

</Project>
