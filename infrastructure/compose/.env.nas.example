# NAS production env — copy to `.env.nas` on the NAS (git-ignored) and fill in REAL values, distinct
# from the local `.env`. Never commit `.env.nas`. See docs/architecture/nas-deployment-profile.md §5,
# docs/runbooks/analytics-module.md and docs/runbooks/nas-runner-setup.md.
#
# .github/workflows/deploy-nas.yml uses this file automatically. To deploy by hand from the NAS:
#   docker compose -f docker-compose.yml -f docker-compose.nas.yml --env-file .env.nas pull
#   docker compose -f docker-compose.yml -f docker-compose.nas.yml --env-file .env.nas up -d --remove-orphans
#
# TELUMERA_IMAGE_TAG selects which GHCR image tag to run; unset ⇒ `latest`. The deploy workflow
# exports it as sha-<short> so a deploy is pinned to an exact build. Set it here only to pin by hand.
# TELUMERA_IMAGE_TAG=latest

# --- Datastores (fresh production passwords, NOT the local dev ones) --------------------------
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_APP_PASSWORD=
RABBITMQ_DEFAULT_USER=telumera
RABBITMQ_DEFAULT_PASS=
REDIS_PASSWORD=
MINIO_ROOT_USER=telumera
MINIO_ROOT_PASSWORD=

# --- Entra ID (same tenant; the three existing app registrations) ----------------------------
# Consumed by the backend services (gateway / identity-workspace / site-registry / analytics).
AZURE_AD_TENANT_ID=
AZURE_AD_API_CLIENT_ID=
AZURE_AD_TEST_CLIENT_ID=
# The dashboard-web image bakes its Entra values in at CI build time from repo Variables
# (VITE_AZURE_AD_TENANT_ID / VITE_AZURE_AD_DASHBOARD_CLIENT_ID / VITE_AZURE_AD_API_SCOPE in
# .github/workflows/container-build.yml), NOT from this file. These two are only needed if you
# ever `docker compose build dashboard-web` on the NAS by hand:
# AZURE_AD_DASHBOARD_CLIENT_ID=
# AZURE_AD_API_SCOPE=api://<Telumera API client id>/access_as_user

# --- Cross-origin: the dashboard is a different host from every API it calls -------------------
# Both the gateway and analytics read this. Prod = the dashboard's own apex origin.
CORS_ALLOWED_ORIGINS=https://telumera.nl

# --- GeoIP -----------------------------------------------------------------------------------
GEOIP_PROVIDER=maxmind
MAXMIND_LICENSE_KEY=
