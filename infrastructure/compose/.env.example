# Local self-hosted runtime secrets. Copy this file to `.env` in this same
# directory (`infrastructure/compose/.env`) and fill in real local values —
# `.env` / `.env.*` are already git-ignored (see repo-root .gitignore), only
# this `.env.example` is committed.
#
# These are throwaway LOCAL DEV credentials only. They are not handled with
# production secret-management practice and must never be reused outside a
# developer's own machine. This is a distinct concern from the public browser
# ingestion token issued later by the Site Registry (see
# docs/adr/0006-public-browser-ingestion-tokens.md) — that token is meant to
# be publicly visible by design and is never stored here.
#
# See infrastructure/compose/README.md for how each value is used, and
# docs/runbooks/local-environment.md for the NAS/production equivalent
# (Docker secrets / Azure Key Vault, not plain env files).

# --- PostgreSQL --------------------------------------------------------
# Bootstrap superuser for the postgres container itself. Only used at
# container startup and by db-init/postgres/00-init-context-databases.sh —
# no application service connects with this account.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-dev

# Shared password for every per-context Postgres role created by
# db-init/postgres/00-init-context-databases.sh (docs/adr/0005). Deliberately
# one shared password across contexts for local onboarding simplicity — each
# role can still only log in to its own database.
APP_DB_PASSWORD=change-me-local-dev

# --- ClickHouse ----------------------------------------------------------
# Bootstrap admin user for the clickhouse-server container itself.
CLICKHOUSE_ADMIN_PASSWORD=change-me-local-dev

# Shared password for every per-context ClickHouse user created by
# db-init/clickhouse/00-init-context-databases.sh (docs/adr/0005).
CLICKHOUSE_APP_PASSWORD=change-me-local-dev

# --- RabbitMQ ------------------------------------------------------------
RABBITMQ_DEFAULT_USER=telumera
RABBITMQ_DEFAULT_PASS=change-me-local-dev

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-local-dev

# --- MinIO -----------------------------------------------------------------
MINIO_ROOT_USER=telumera
MINIO_ROOT_PASSWORD=change-me-local-dev

# --- Microsoft Entra ID (docs/runbooks/local-environment.md's "Auth" section) ---------------
# Not classic secrets (a tenant/client ID is visible in any issued token or redirect URI), but
# kept out of committed appsettings.json anyway since they're specific to one person's Entra ID
# tenant — same reasoning as docs/architecture/nas-deployment-profile.md staying generic.
#
# Tenant ID from the Entra admin center's Overview page.
AZURE_AD_TENANT_ID=
# Application (client) ID of the "Telumera API" app registration (the one with the
# access_as_user scope exposed under "Expose an API"). identity-workspace and site-registry
# both validate incoming tokens against this.
AZURE_AD_API_CLIENT_ID=
# Application (client) ID of the separate "Telumera CLI Test Client" app registration (public
# client, device-code flow enabled) — used only by scripts/get-dev-token.sh/.ps1 to obtain a
# real bearer token for manual testing until the dashboard has real sign-in wired up.
AZURE_AD_TEST_CLIENT_ID=

# --- Gateway CORS ------------------------------------------------------------
# Comma-separated origins allowed to call the gateway cross-origin — apps/dashboard-web's Vite
# dev server, not the gateway's own host port. See gateway/README.md.
CORS_ALLOWED_ORIGINS=http://localhost:5173
